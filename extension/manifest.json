{
  "manifest_version": 3,
  "name": "Vigil",
  "version": "2.0.0",
  "description": "Circule um trecho de qualquer página e seja avisado quando ele mudar, aparecer ou sumir.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "notifications",
    "alarms",
    "contextMenus"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Vigil",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "commands": {
    "start-pen": {
      "suggested_key": {
        "default": "Alt+Shift+V"
      },
      "description": "Ligar a caneta na aba atual"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/inter.woff2"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
