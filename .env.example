# Tudo aqui é opcional: sem .env o Vigil roda com os padrões abaixo.
DATABASE_URL=postgres://vigil:vigil@localhost:5432/vigil
PORT=3000
APP_URL=http://localhost:3000
SESSION_SECRET=troque-por-uma-string-aleatoria

# Limites (padrões pensados para uso local)
MIN_INTERVAL_MINUTES=5
MANUAL_CHECK_COOLDOWN_SECONDS=30
MAX_WATCHES_PER_USER=20
WORKER_POLL_MS=5000
WORKER_CONCURRENCY=3

# Opcional: e-mail real via Resend. Vazio = link de login e alertas no console.
RESEND_API_KEY=
MAGIC_LINK_FROM=Vigil <onboarding@resend.dev>

# Opcional: login com Google. Vazio = só link mágico.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Padrão: ${APP_URL}/auth/google/callback
GOOGLE_REDIRECT_URI=
# Client ID da extensão, se for diferente do web
GOOGLE_EXTENSION_CLIENT_ID=
